{
  "name": "injectinator-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "dev": "node scripts/build-data.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/build-data.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "test": "node --test test/",
    "e2e": "node e2e/e2e.mjs",
    "e2e:live": "node e2e/live.e2e.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.65.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
